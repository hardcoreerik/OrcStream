execute_process(COMMAND "${DEMO}" write "${OUT}" 48 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "write demo failed: ${rc}")
endif()
execute_process(COMMAND "${DEMO}" verify "${OUT}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "verify demo failed: ${rc}")
endif()
file(REMOVE "${OUT}")
